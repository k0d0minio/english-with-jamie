# Neon Postgres (pooled connection string from the Vercel Storage tab)
DATABASE_URL=

# Neon Auth (Managed Better Auth). The base URL is set by the Vercel Neon integration;
# the cookie secret signs the cached session cookie (openssl rand -base64 32).
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Bank details shown on /payments with a copy button, for topping up lessons. Multi-line is
# fine (or use \n). Kept out of git because the repo is public.
BANK_DETAILS=

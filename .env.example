# Neon Postgres (pooled connection string from the Vercel Storage tab)
DATABASE_URL=

# Session signing secret: any long random string (openssl rand -base64 48)
AUTH_SECRET=

# Access codes. One for the teacher, one for the student. Change them any time;
# existing sessions stay valid until they expire (30 days).
TEACHER_CODE=
STUDENT_CODE=

# Bank details shown on /account with a copy button, for topping up lessons. Multi-line is
# fine (or use \n). Kept out of git because the repo is public.
BANK_DETAILS=
